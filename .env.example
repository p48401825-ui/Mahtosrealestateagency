# Copy this file to .env locally and fill real values. NEVER commit .env.

# Secret used to sign login tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Admin account created on first run
ADMIN_EMAIL=admin@mahtos.com
ADMIN_PASSWORD=Mahtos@2024

# Agency details shown on the site
AGENCY_NAME=Mahto's Real Estate Agency
AGENCY_PHONE=+91 98765 43210
AGENCY_EMAIL=info@mahtos.com
AGENCY_ADDRESS=Main Market Road, Udhampur, Jammu & Kashmir 182101
AGENCY_GST=GSTIN-XXXXX (add your GST number)
AGENCY_RERA=RERA Reg. No. XXXXX (add your RERA registration)
AGENCY_PAN=PAN-XXXXX (add your PAN)
